# mediavault-mcp local configuration
# Copy to .env next to this project, or export the variables in your shell.
# Real environment variables always win over .env files.

# Media library root (downloads + resource.json + summary artifacts)
# MEDIAVAULT_HOME=~/MediaVault

# Network proxy, required for tiktok / instagram / x in some regions.
# Bare host:port is assumed HTTP; explicit schemes http/https/socks4/socks5/socks5h
# are accepted. An invalid proxy fails fast with a clear error instead of a
# cryptic CLI/httpx stack trace.
# MEDIAVAULT_PROXY=http://127.0.0.1:7890

# Reuse a logged-in browser session for login-walled content (IG/FB/Bilibili...)
# MEDIAVAULT_COOKIES_BROWSER=chrome
# Or a Netscape cookies.txt file. It is validated before use: a missing or
# malformed file is skipped with a warning on the result (and COOKIES_BROWSER
# takes over when set) rather than aborting extraction.
# MEDIAVAULT_COOKIES_FILE=/path/to/cookies.txt

# OpenAI-compatible endpoint used for chat, transcription and vision.
# Works with OpenAI, Volcengine Ark, DeepSeek, local vLLM/Ollama shims, etc.
# For a fully local setup point this at e.g. http://localhost:11434/v1 and set
# OPENAI_API_KEY to any non-empty placeholder (local servers ignore it).
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# MEDIAVAULT_LLM_MODEL=gpt-4o-mini
# A vision-capable model for keyframe analysis (can equal LLM_MODEL).
# MEDIAVAULT_VLM_MODEL=gpt-4o-mini

# --- Video summarization pipeline ---
# Speech-to-text backend:
#   openai = POST /audio/transcriptions on the endpoint above (needs the key)
#   local  = local faster-whisper (install with: uv pip install -e ".[local-asr]")
#   off    = never transcribe; summaries use captions (+ vision) only
# MEDIAVAULT_ASR_BACKEND=openai
# Model id sent to the /audio/transcriptions endpoint when backend=openai.
# MEDIAVAULT_ASR_MODEL=whisper-1
# faster-whisper model size when backend=local (tiny/base/small/medium/large-v3).
# MEDIAVAULT_WHISPER_MODEL=base
# Compute device for local ASR: cpu (default), mps on Apple Silicon, cuda on NVIDIA.
# MEDIAVAULT_WHISPER_DEVICE=cpu
# Keyframe budget per video and downscale width (controls VLM token usage).
# MEDIAVAULT_KEYFRAME_MAX=8
# MEDIAVAULT_KEYFRAME_WIDTH=768
# Keyframe selection strategy:
#   interval = evenly spread frames (default, unchanged behavior)
#   hybrid   = uniform anchors merged with ffmpeg detected scene cuts
#   scene    = detected scene cuts only (falls back to interval if none found)
# MEDIAVAULT_KEYFRAME_MODE=interval
# ffmpeg scene-change score (0..1) above which a new cut is detected (hybrid/scene).
# MEDIAVAULT_SCENE_THRESHOLD=0.4
# Speaker turn labels over the transcript:
#   off       = no diarization (default)
#   heuristic = dependency-free A/B turn labeling from inter-segment pauses.
# These are conversational turns, not voiceprint-identified people, and need no
# model download or API key. A future embedding-based backend plugs into the same
# Diarizer interface.
# MEDIAVAULT_DIARIZATION=off
# Pause in milliseconds that starts a new speaker turn (heuristic mode only).
# MEDIAVAULT_DIARIZE_GAP_MS=700

# Optional f2 CLI for Douyin/Xiaohongshu/Kuaishou/TikTok native extraction.
# When the binary is absent the registry transparently falls back to yt-dlp.
# Note: f2 reads cookies from its own YAML config; MEDIAVAULT_COOKIES_* only
# contributes a proxy to f2 and emits a reminder for the cookie config.
# MEDIAVAULT_F2_BIN=f2

# Optional gallery-dl CLI for image-set posts (Xiaohongshu, Instagram, Pinterest,
# Weibo). Absent binary transparently falls back to yt-dlp.
# MEDIAVAULT_GALLERYDL_BIN=gallery-dl

# --- M4: local real-browser bootstrap for JS-VM anti-bot challenges ---
# Platforms such as Douyin authorize their detail API only for a real browser
# (JS-VM challenge + ambient fingerprint/signing headers). When enabled,
# mediavault launches a local Playwright browser, clears the challenge
# ANONYMOUSLY (no account login), runs an in-page fetch of the detail API and
# parses the signed CDN URL, then downloads it directly. External CLI clients
# (yt-dlp/f2) stay as the unchanged fallback chain. Off by default; a missing
# Playwright or an uncleared challenge degrades via AdapterStale instead of
# failing. No cookie values are logged; only names appear in notes.
# Install: uv pip install -e ".[browser]" && playwright install chromium
# MEDIAVAULT_BROWSER_BOOTSTRAP=off
# Browser engine: chromium (default) | firefox | webkit
# MEDIAVAULT_BROWSER_ENGINE=chromium
# Set false to watch the browser window (useful when a challenge needs a click)
# MEDIAVAULT_BROWSER_HEADLESS=true
# Max time to wait for the challenge to clear / CDN download timeout, in ms.
# MEDIAVAULT_BROWSER_TIMEOUT_MS=30000
